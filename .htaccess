RewriteEngine On

# Keep framework and application source private, including root deployments.
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(?:CorianderCore|src|config|vendor|nodejs|database|backups|cache|logs|tests|docs|old_portfolio)(?:/|$) - [F,L,NC]
RewriteRule \.(?:bak(?:\.\d+)?|log|sqlite(?:3)?|db)$ - [F,L,NC]
RewriteRule ^(?:coriander|composer\.(?:json|lock|phar)|phpunit\.xml|AGENTS\.md|README\.md)$ - [F,L,NC]
RewriteRule ^public/(?:public_views(?:/|$)|routes\.php$) - [F,L,NC]

# Only the front controller may execute PHP through HTTP.
RewriteCond %{REQUEST_URI} !^/public/index\.php$
RewriteRule \.php(?:/|$) - [F,L,NC]

# Ensure the default directory index is public/index.php
DirectoryIndex public/index.php

# Disable directory listing for security
Options -Indexes

# Serve public static files when the project root is the web root.
RewriteRule ^(assets/.*|favicon\.ico|sitemap\.xml|robots?\.txt)$ public/$1 [L]

# Exclude static files (CSS, JS, images) from routing to index.php
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule \.(css|js|png|jpg|jpeg|gif|svg|webp)$ - [L]

# Only route non-existent files or directories to public/index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/index.php [QSA,L]

# Error pages
ErrorDocument 404 /page-not-found
